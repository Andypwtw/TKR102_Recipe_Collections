{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "/workspace/python/scripts/10_pipeline.py",
      "cwd": "/workspace/python",
      "env": {
        "PYTHONPATH": "/workspace/python"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Flask API",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "--app",
        "app.api:app",
        "run",
        "--host=0.0.0.0",
        "--port=5000",
        "--debug"
      ],
      "cwd": "/workspace/python",
      "env": {
        "PYTHONPATH": "/workspace/python"
      },
      "console": "integratedTerminal"
    }
  ]
}
