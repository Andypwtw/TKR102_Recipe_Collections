Project Recipe_Collections {
  database_type: 'MySQL'
  Note: 'YTower 食譜清洗、正規化、營養對照、Flask API 專案'
}

Table recipes {
  id bigint [pk, increment, unsigned]
  seq varchar(32) [not null, unique, note: '來源食譜唯一編號，例如 A01-002']
  name varchar(255) [not null]
  published_date date
  source_url varchar(1024)
  raw_keywords text
  steps longtext
  created_at timestamp
  updated_at timestamp
}

Table keywords {
  id bigint [pk, increment, unsigned]
  name varchar(120) [not null, unique]
}

Table recipe_keywords {
  recipe_id bigint [pk, not null, unsigned]
  keyword_id bigint [pk, not null, unsigned]
}

Table ingredients {
  id bigint [pk, increment, unsigned]
  canonical_name varchar(255) [not null, unique, note: '清洗後標準食材名稱']
  category varchar(120)
  created_at timestamp
}

Table ingredient_aliases {
  id bigint [pk, increment, unsigned]
  ingredient_id bigint [not null, unsigned]
  alias_name varchar(255) [not null, unique]
  source varchar(50) [not null, default: 'dictionary']
}

Table units {
  id bigint [pk, increment, unsigned]
  canonical_unit varchar(64) [not null, unique]
  unit_type varchar(32) [not null, note: 'mass / volume / household / count / qualitative / unknown']
  to_gram_factor decimal(18,6)
  to_ml_factor decimal(18,6)
  is_qualitative boolean [not null, default: false]
}

Table ingredient_unit_weights {
  id bigint [pk, increment, unsigned]
  ingredient_id bigint [not null, unsigned]
  unit_id bigint [not null, unsigned]
  grams_per_unit decimal(18,6) [not null]
  source varchar(255)
  note varchar(500)

  indexes {
    (ingredient_id, unit_id) [unique]
  }
}

Table ingredient_densities {
  id bigint [pk, increment, unsigned]
  ingredient_id bigint [not null, unsigned]
  density_g_ml decimal(18,6) [not null, note: '食材每 1 ml 的克重；粉類為廚房鬆裝 bulk density']
  density_type varchar(32) [not null, default: 'liquid', note: 'liquid / semi_liquid / bulk']
  confidence varchar(20) [not null, default: '中']
  status varchar(20) [not null, default: 'ACTIVE', note: 'ACTIVE / REVIEW']
  source varchar(255)
  note varchar(500)
  updated_at timestamp

  indexes {
    ingredient_id [unique]
  }
}

Table recipe_ingredients {
  id bigint [pk, increment, unsigned]
  recipe_id bigint [not null, unsigned]
  line_no int [not null]
  raw_text varchar(1000) [not null]
  raw_name varchar(255)
  ingredient_id bigint [not null, unsigned]
  raw_amount_text varchar(255)
  quantity_min decimal(18,6)
  quantity_max decimal(18,6)
  quantity_value decimal(18,6) [note: '單值或範圍平均值']
  unit_id bigint [unsigned]
  weight_g decimal(18,6) [note: '可換算時才寫入；適量/少許或未知單位保留 NULL']
  is_estimated boolean [not null, default: false]
  needs_manual_review boolean [not null, default: false]
  review_reason varchar(500)

  indexes {
    (recipe_id, line_no) [unique]
  }
}

Table nutrition_source {
  id bigint [pk, increment, unsigned]
  source_code varchar(50) [not null, unique, note: '食品營養成分資料庫整合編號']
  food_category varchar(120)
  sample_name varchar(255) [not null]
  content_description text
  common_name text
  waste_rate_pct decimal(18,6)
  energy_kcal decimal(18,6)
  corrected_energy_kcal decimal(18,6)
  water_g decimal(18,6)
  protein_g decimal(18,6)
  fat_g decimal(18,6)
  saturated_fat_g decimal(18,6)
  carbohydrate_g decimal(18,6)
  dietary_fiber_g decimal(18,6)
  sodium_mg decimal(18,6)
  potassium_mg decimal(18,6)
  calcium_mg decimal(18,6)
  magnesium_mg decimal(18,6)
  iron_mg decimal(18,6)
  zinc_mg decimal(18,6)
  phosphorus_mg decimal(18,6)
  vitamin_a_re_ug decimal(18,6)
  vitamin_b1_mg decimal(18,6)
  vitamin_b2_mg decimal(18,6)
  niacin_mg decimal(18,6)
  vitamin_b6_mg decimal(18,6)
  vitamin_b12_ug decimal(18,6)
  folate_ug decimal(18,6)
  vitamin_c_mg decimal(18,6)
  vitamin_e_mg decimal(18,6)
  cholesterol_mg decimal(18,6)
  raw_data json [not null, note: '完整保留 Excel 該列所有欄位']
  source_version varchar(50) [not null, default: '2025']
  created_at timestamp
}

Table ingredient_nutrition_map {
  ingredient_id bigint [pk, unsigned]
  nutrition_source_id bigint [not null, unsigned]
  match_method varchar(50) [not null]
  match_score decimal(8,6) [not null, default: 1]
  status varchar(20) [not null, default: 'AUTO', note: 'AUTO / MANUAL']
  reviewed_at datetime
}

Table manual_review {
  id bigint [pk, increment, unsigned]
  ingredient_id bigint [not null, unsigned]
  candidate_nutrition_id bigint [unsigned]
  candidate_name varchar(255)
  score decimal(8,6)
  status varchar(20) [not null, default: 'PENDING', note: 'PENDING / APPROVED / REJECTED']
  note varchar(500)
  created_at timestamp
  reviewed_at datetime
}

Table recipe_nutrition_summary {
  recipe_id bigint [pk, unsigned]
  known_weight_g decimal(18,6) [not null, default: 0]
  total_ingredient_rows int [not null, default: 0]
  matched_ingredient_rows int [not null, default: 0]
  coverage_percent decimal(8,3) [not null, default: 0]
  energy_kcal decimal(18,6)
  protein_g decimal(18,6)
  fat_g decimal(18,6)
  carbohydrate_g decimal(18,6)
  dietary_fiber_g decimal(18,6)
  sodium_mg decimal(18,6)
  potassium_mg decimal(18,6)
  calcium_mg decimal(18,6)
  magnesium_mg decimal(18,6)
  iron_mg decimal(18,6)
  zinc_mg decimal(18,6)
  phosphorus_mg decimal(18,6)
  vitamin_a_re_ug decimal(18,6)
  vitamin_b1_mg decimal(18,6)
  vitamin_b2_mg decimal(18,6)
  niacin_mg decimal(18,6)
  vitamin_b6_mg decimal(18,6)
  vitamin_b12_ug decimal(18,6)
  folate_ug decimal(18,6)
  vitamin_c_mg decimal(18,6)
  vitamin_e_mg decimal(18,6)
  cholesterol_mg decimal(18,6)
  calculated_at timestamp
}

Table etl_runs {
  id bigint [pk, increment, unsigned]
  pipeline_name varchar(100) [not null]
  started_at datetime [not null]
  finished_at datetime
  status varchar(20) [not null]
  processed_rows int [not null, default: 0]
  message text
}

Ref: recipe_keywords.recipe_id > recipes.id [delete: cascade]
Ref: recipe_keywords.keyword_id > keywords.id [delete: cascade]
Ref: ingredient_aliases.ingredient_id > ingredients.id [delete: cascade]
Ref: ingredient_unit_weights.ingredient_id > ingredients.id [delete: cascade]
Ref: ingredient_unit_weights.unit_id > units.id [delete: cascade]
Ref: ingredient_densities.ingredient_id - ingredients.id [delete: cascade]
Ref: recipe_ingredients.recipe_id > recipes.id [delete: cascade]
Ref: recipe_ingredients.ingredient_id > ingredients.id
Ref: recipe_ingredients.unit_id > units.id
Ref: ingredient_nutrition_map.ingredient_id - ingredients.id [delete: cascade]
Ref: ingredient_nutrition_map.nutrition_source_id > nutrition_source.id
Ref: manual_review.ingredient_id > ingredients.id [delete: cascade]
Ref: manual_review.candidate_nutrition_id > nutrition_source.id
Ref: recipe_nutrition_summary.recipe_id - recipes.id [delete: cascade]
